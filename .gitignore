# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
bin/
lib/
share/
Include/

# Data and Outputs (Large binary files)
data/images/*
!data/images/.gitkeep
data/output/*
!data/output/.gitkeep

